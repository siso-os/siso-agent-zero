#!/usr/bin/env bash
# spawn-worker — start an agent on the team's substrate and hand it a brief.
#
#   spawn-worker --name NAME --brief /abs/path/BRIEF.md --harness claude|codex|raw \
#                [--model opus|luna|qwen] [--cwd DIR] [--workspace WID] [--host SSH_HOST] \
#                [--substrate herdr|orca] [--title TEXT] [--team-dir DIR] [--worktree] [--max-lanes N] [-- argv...]
#   --worktree   give the agent its own lane: <cwd>/.worktrees/<name> forked from origin/main; refuses past --max-lanes (3)
#
# SUBSTRATE. herdr is the default and stays the substrate on the laptop and the Mac Mini, where
# Orca does not run. `--substrate orca` starts the agent as an Orca terminal in the team's
# worktree instead, so it appears on the Agents tab with live status — which is the whole point:
# Shaan opens Agents and sees his labs. The team's default lives in team.yaml as `substrate:`,
# and the runtime/repo/worktree under `orca:`. An Orca agent is titled `<domain> · <brief id>`
# (the tab title — Claude Code overwrites the terminal title with its own summary) and the
# handle it returns is what az-send, az-notify and fleet-status address it by.
#
# Harness → model, as Shaan ruled on 2026-09-11:
#   claude  opus   the Project Agent Zero and every owner (Claude Code is their best harness)
#
#   --autocompact N|auto   auto-compact window for a claude agent (default 250000).
#                          250k: disposable owners and arms. 400000: a resident Agent Zero.
#                          `auto` disables the cap (resolves to the model default, 1m).
#   codex   astra  GPT-6 Astra in Codex CLI (-m gpt-6-astra). The strongest non-Claude model on
#                  this box, on a SEPARATE quota from the Claude plan, so it costs nothing the
#                  Opus owners need. Use it for a resident orchestrator or heavy analysis.
#   codex   luna   arm: GPT-5.6 Luna in Codex CLI (-m gpt-5.6-luna)
#   codex   qwen   arm: pool Qwen in Codex CLI through model_provider siso-pool (codex/config.pool.toml)
#   raw     —      anything after `--` (used by the tests)
#
# Works on herdr 0.6 and 0.9 alike: it creates a tab in the space, types the command into that
# tab's shell, waits for the agent's prompt, then hands over the brief with az-send. On a team host
# `siso-agent` starts claude as the agents user on the same pty so herdr can see it.
# The brief file MUST end with RETURN (the one message the worker sends back) and STOP.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
NAME=""; BRIEF=""; HARNESS=""; MODEL=""; CWD="$PWD"; WS=""; HOST=""; WT=0; CAP="${SPAWN_MAX_LANES:-3}"
SUBSTRATE=""; TITLE=""; SPAWN_TEAM_DIR="${SPAWN_TEAM_DIR:-}"
# LABS-36: the auto-compact window every spawned Claude agent inherits. 250k for disposable
# owners and arms; pass --autocompact 400000 for a resident Agent Zero, or `auto` for no cap.
AUTOCOMPACT="${SPAWN_AUTOCOMPACT:-250000}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) NAME="$2"; shift 2;; --brief) BRIEF="$2"; shift 2;; --harness) HARNESS="$2"; shift 2;;
    --model) MODEL="$2"; shift 2;; --cwd) CWD="$2"; shift 2;; --workspace) WS="$2"; shift 2;;
    --host) HOST="$2"; shift 2;; --worktree) WT=1; shift;; --max-lanes) CAP="$2"; shift 2;;
    --substrate) SUBSTRATE="$2"; shift 2;; --title) TITLE="$2"; shift 2;; --team-dir) SPAWN_TEAM_DIR="$2"; shift 2;;
    --autocompact) AUTOCOMPACT="$2"; shift 2;;
    -h|--help) sed -n 2,24p "$0"; exit 0;; --) shift; break;;
    *) echo "spawn-worker: unknown flag $1" >&2; exit 64;;
  esac
done
[[ -n "$NAME" && -n "$HARNESS" ]] || { echo "spawn-worker: --name and --harness are required" >&2; exit 64; }
[[ "$NAME" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "spawn-worker: --name must contain only letters, digits, dot, underscore, or hyphen" >&2; exit 64; }
[[ "$CAP" =~ ^[1-9][0-9]*$ ]] || { echo "spawn-worker: --max-lanes must be a positive integer" >&2; exit 64; }
[[ "$HARNESS" == raw || -n "$BRIEF" ]] || { echo "spawn-worker: --brief is required" >&2; exit 64; }
[[ -z "$BRIEF" || -r "$BRIEF" ]] || { echo "spawn-worker: brief is not readable: $BRIEF" >&2; exit 64; }
# An owner TASK brief must pass brief-lint (verbatim quote plus task-appropriate acceptance).
# 2026-09-12: three owners built the wrong thing from briefs that would have failed this.
# Set SPAWN_NO_LINT=1 only for an explicitly documented bootstrap exception.
if [[ -n "$BRIEF" && "$HARNESS" == claude && "${SPAWN_NO_LINT:-0}" != 1 && "$(basename "$BRIEF")" == TASK-*.md ]]; then
  # Resolve the companion team explicitly when supplied; otherwise walk the brief's
  # ancestors until the actual team intent/manifest is found. Never guess dirname/.. .
  TEAM_DIR="${SPAWN_TEAM_DIR:-}"
  if [[ -z "$TEAM_DIR" ]]; then
    CUR="$(cd "$(dirname "$BRIEF")" 2>/dev/null && pwd)"
    while [[ -n "$CUR" && "$CUR" != / ]]; do
      if [[ -d "$CUR/intent" || -f "$CUR/team.yaml" || -f "$CUR/manifest.json" ]]; then TEAM_DIR="$CUR"; break; fi
      CUR="$(dirname "$CUR")"
    done
  fi
  INTENT_DIR=""
  if [[ -n "$TEAM_DIR" && -r "$TEAM_DIR/team.yaml" ]]; then
    INTENT_DIR="$(python3 - "$TEAM_DIR/team.yaml" <<'PY'
import os, sys, yaml
data = yaml.safe_load(open(sys.argv[1])) or {}
value = ((data.get('agent_zero') or {}).get('intent_log') if isinstance(data, dict) else None) or ''
if value:
    print(os.path.abspath(os.path.join(os.path.dirname(sys.argv[1]), value)))
PY
    )"
  fi
  if [[ -z "$INTENT_DIR" && -n "$TEAM_DIR" && -r "$TEAM_DIR/manifest.json" ]]; then
    INTENT_DIR="$(python3 - "$TEAM_DIR/manifest.json" <<'PY'
import json, os, sys
data = json.load(open(sys.argv[1]))
value = ((data.get('agent_zero') or {}).get('intent_log') if isinstance(data, dict) else None) or data.get('intent_log', '')
if value:
    print(os.path.abspath(os.path.join(os.path.dirname(sys.argv[1]), value)))
PY
    )"
  fi
  [[ -n "$INTENT_DIR" && -d "$INTENT_DIR" ]] || INTENT_DIR="${TEAM_DIR:+$TEAM_DIR/intent}"
  if [[ -n "$TEAM_DIR" && -d "$INTENT_DIR" ]]; then
    "$HERE/brief-lint" --team "$(basename "$TEAM_DIR")" --intent-dir "$INTENT_DIR" "$BRIEF" || { echo "spawn-worker: brief refused by brief-lint (fix it, or SPAWN_NO_LINT=1 and say why)" >&2; exit 65; }
  else
    echo "spawn-worker: cannot resolve team intent directory; pass --team-dir or use SPAWN_NO_LINT=1 with a reason" >&2
    exit 65
  fi
fi

# team.yaml: the team's default substrate and its Orca coordinates. Looked for beside the tools
# dir, then in the companion repo the caller names with --team-dir.
teamcfg() {  # teamcfg <dotted.key> -> value or empty
  local f
  for f in "${SPAWN_TEAM_DIR:+$SPAWN_TEAM_DIR/team.yaml}" "$HERE/../team.yaml" "$PWD/team.yaml"; do
    [[ -n "$f" && -r "$f" ]] || continue
    python3 -c '
import sys, yaml
d = yaml.safe_load(open(sys.argv[1])) or {}
for k in sys.argv[2].split("."):
    d = (d or {}).get(k) if isinstance(d, dict) else None
print(d if d is not None else "")' "$f" "$1" 2>/dev/null && return 0
  done
  echo ""
}
[[ -n "$SUBSTRATE" ]] || SUBSTRATE="$(teamcfg substrate)"
SUBSTRATE="${SUBSTRATE:-herdr}"
case "$SUBSTRATE" in herdr|orca) ;; *) echo "spawn-worker: --substrate must be herdr or orca" >&2; exit 64;; esac
[[ "$SUBSTRATE" == orca || -n "$WS" ]] || { echo "spawn-worker: --workspace is required on herdr" >&2; exit 64; }

hrun() { if [[ -n "$HOST" ]]; then ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" "$(printf '%q ' herdr "$@")"; else herdr "$@"; fi; }
hread() { hrun pane read "$1" --lines 30 --format text 2>/dev/null || true; }

case "$HARNESS" in
  claude)
    MODEL="${MODEL:-opus}"
    if [[ -n "$HOST" ]]; then HAS_SA="$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" 'command -v siso-agent' 2>/dev/null || true)"
    elif [[ $EUID -eq 0 ]]; then HAS_SA="$(command -v siso-agent || true)"; else HAS_SA=""; fi
    if [[ -n "$HAS_SA" ]]; then CMD="siso-agent --dangerously-skip-permissions"; else CMD="claude --dangerously-skip-permissions"; fi
    # LABS-36. Cap the chat length at spawn. MUST be the CLI flag, not the env var:
    # siso-agent rebuilds the environment with an `env` whitelist (HOME/USER/LOGNAME/PATH/TERM)
    # and would DROP CLAUDE_CODE_AUTO_COMPACT_WINDOW silently, which looks exactly like success.
    # `siso-agent ... "$@"` forwards the flag, so one spelling works on both paths.
    # Verify in the spawned agent with /autocompact — it prints the window AND its source.
    [[ "$AUTOCOMPACT" == auto ]] || CMD="$CMD --autocompact $AUTOCOMPACT"
    READY='❯|bypass permissions';;
  codex)
    MODEL="${MODEL:-luna}"
    case "$MODEL" in
      astra) CMD="codex --dangerously-bypass-approvals-and-sandbox -m gpt-6-astra";;
      luna) CMD="codex --dangerously-bypass-approvals-and-sandbox -m gpt-5.6-luna";;
      qwen) CMD="codex --dangerously-bypass-approvals-and-sandbox -c model_provider=siso-pool -m siso-kaggle-worker/qwen3.8-27b";;
      *) echo "spawn-worker: codex model must be astra, luna or qwen" >&2; exit 64;;
    esac
    [[ "$MODEL" == qwen ]] && CMD="set -a; . ~/.config/siso/pool.env 2>/dev/null; set +a; $CMD"
    READY='›|codex|Codex';;
  raw) CMD="$(printf '%q ' "$@")"; READY='.';;
  *) echo "spawn-worker: --harness must be claude, codex or raw" >&2; exit 64;;
esac

# ---- Orca ------------------------------------------------------------------------------
if [[ "$SUBSTRATE" == orca ]]; then
  [[ -z "$HOST" ]] || { echo "spawn-worker: --host is a herdr flag; Orca reaches its own execution hosts" >&2; exit 64; }
  [[ $WT -eq 0 ]] || { echo "spawn-worker: --worktree is a herdr lane. On Orca the team shares one checkout; make a lane with 'orca worktree create' and pass --cwd." >&2; exit 64; }
  # shellcheck source=lib/orca.sh
  . "$HERE/lib/orca.sh"

  SEL="$(teamcfg orca.worktree)"; SEL="${ORCA_WORKTREE:-${SEL:-branch:$(teamcfg project.branch)}}"
  [[ "$SEL" != "branch:" ]] || { echo "spawn-worker: no orca.worktree in team.yaml and no --worktree selector" >&2; exit 64; }
  orca_available || { echo "spawn-worker: the Orca runtime is not reachable (orcad down, or this user cannot see it)" >&2; exit 1; }

  # `<domain> · <brief id>`; the brief id is the LABS-nn in the brief's filename, because the board
  # is canonical and the file name carries it.
  #
  # WHY WE DO NOT ALSO `terminal rename` AFTER THE AGENT STARTS. Two titles exist and they do
  # different jobs. --title sets the TAB record, which never changes and is what az-send,
  # az-dispatch and fleet-status address the agent by. The pty title is Claude Code's own: it
  # rewrites it with a summary of the session and prefixes a live status glyph (◐/◑ working,
  # ✳ idle), and the Agents tab strip shows THAT one. Forcing it with `orca terminal rename`
  # makes the label stick — and kills the glyph, because Orca reads Claude's status out of the
  # title text. Measured 2026-09-12: renamed terminals go statusless. We keep the pty title,
  # because a real owner's summary already reads like its brief ("LABS-15 BUZZ candidate
  # selection" is a live herdr title today) and Shaan gets the name AND the status.
  if [[ -z "$TITLE" ]]; then
    BID=""
    if [[ -n "$BRIEF" ]]; then
      B="$(basename "$BRIEF")"; B="${B%.md}"
      [[ "$B" =~ ^TASK-([A-Za-z]+-[0-9]+) ]] && BID="${BASH_REMATCH[1]}" || BID="${B#TASK-}"
    fi
    TITLE="$NAME${BID:+ · $BID}"
  fi

  if [[ "$HARNESS" == claude ]]; then   # pre-answer "trust this folder?" — Orca already runs as the agents user
    python3 -c 'import json,os,sys
p=os.path.expanduser("~/.claude.json"); d=json.load(open(p)) if os.path.exists(p) else {}
d.setdefault("projects",{}).setdefault(sys.argv[1],{})["hasTrustDialogAccepted"]=True; json.dump(d,open(p,"w"),indent=2)' "$CWD" >/dev/null 2>&1 || true
  fi

  # cd first: the terminal opens in the worktree root, and an owner's cwd is often the companion repo.
  RUN="$CMD"; [[ "$CWD" == "$PWD" ]] || RUN="cd $(printf '%q' "$CWD") && $CMD"
  CREATE="$(orca_cli terminal create --worktree "$SEL" --title "$TITLE" --command "$RUN" --json 2>&1)" || {
    echo "spawn-worker: orca terminal create failed: ${CREATE:0:300}" >&2; exit 1; }
  HANDLE="$(printf '%s' "$CREATE" | python3 -c 'import json,sys
try: print(json.load(sys.stdin)["result"]["terminal"]["handle"])
except Exception: pass')"
  [[ -n "$HANDLE" ]] || { echo "spawn-worker: no handle in: ${CREATE:0:300}" >&2; exit 1; }
  echo "started $NAME terminal=$HANDLE substrate=orca harness=$HARNESS model=${MODEL:-raw} title=$TITLE worktree=$SEL cwd=$CWD"

  if [[ "$HARNESS" != raw ]]; then
    OUT=""
    for i in $(seq 1 "${SPAWN_WAIT_TRIES:-15}"); do
      sleep 3; OUT="$(orca_read "$HANDLE" 30)"
      printf '%s' "$OUT" | grep -qE "$READY" && break
    done
    if printf '%s' "$OUT" | grep -qiE 'trust this folder'; then
      orca_cli terminal send --terminal "$HANDLE" --text $'\e[B' >/dev/null 2>&1
      sleep 0.5; orca_cli terminal send --terminal "$HANDLE" --text "" --enter >/dev/null 2>&1; sleep 6
      OUT="$(orca_read "$HANDLE" 30)"
    fi
    printf '%s' "$OUT" | grep -qE "$READY" || echo "spawn-worker: WARNING no prompt seen in $HANDLE after the wait; sending the brief anyway" >&2
  else
    sleep "${SPAWN_BOOT_SECS:-2}"
  fi

  if [[ -n "$BRIEF" ]]; then
    # az-send exits 2 when Orca observed the Enter being swallowed — that is a real failure to
    # hand over the brief, and the caller must see it rather than a started-but-silent agent.
    "$HERE/az-send" "$HANDLE" "Read and execute the brief at $BRIEF. It ends with RETURN and STOP; obey both." || {
      rc=$?; echo "spawn-worker: the agent is running as $HANDLE but the brief was NOT delivered (az-send exit $rc)" >&2; exit $rc; }
  fi
  exit 0
fi

if [[ "$HARNESS" == claude ]]; then   # Claude Code asks "trust this folder?" with No selected; pre-answer it for the agent user
  TRUST="python3 -c 'import json,os,sys
p=os.path.expanduser(\"~/.claude.json\"); d=json.load(open(p)) if os.path.exists(p) else {}
d.setdefault(\"projects\",{}).setdefault(sys.argv[1],{})[\"hasTrustDialogAccepted\"]=True; json.dump(d,open(p,\"w\"),indent=2)' \"$CWD\""
  if [[ -n "$HOST" ]]; then U=""; [[ -n "$HAS_SA" ]] && U="sudo -u ${SISO_AGENT_USER:-siso} -H"; ssh -o BatchMode=yes "$HOST" "$U bash -c $(printf '%q' "$TRUST")" >/dev/null 2>&1 || true
  else [[ -n "$HAS_SA" ]] && sudo -u "${SISO_AGENT_USER:-siso}" -H bash -c "$TRUST" >/dev/null 2>&1 || bash -c "$TRUST" >/dev/null 2>&1 || true; fi
fi
if [[ $WT -eq 1 ]]; then   # the owner's lane: a worktree forked from configured origin branch, capped (Oracle: ≤3 live lanes)
  BASE_BRANCH="$(teamcfg project.branch)"; BASE_BRANCH="${BASE_BRANCH:-main}"
  [[ "$BASE_BRANCH" =~ ^[A-Za-z0-9._/-]+$ && "$BASE_BRANCH" != -* ]] || { echo "spawn-worker: invalid project.branch: $BASE_BRANCH" >&2; exit 64; }
  BASE_REF="origin/$BASE_BRANCH"; LANE_BRANCH="lane/$NAME"; LANE_PATH=".worktrees/$NAME"
  WTCMD="set -e; cd $(printf '%q' "$CWD"); git fetch -q origin; n=\$(git worktree list --porcelain | awk '/^worktree / && /\\/.worktrees(\\/|$)/ {n++} END {print n+0}'); if [ \"\$n\" -ge $CAP ]; then echo \"spawn-worker: $CAP live lanes already; close one first\" >&2; exit 3; fi; git worktree add -q -b $(printf '%q' "$LANE_BRANCH") $(printf '%q' "$LANE_PATH") $(printf '%q' "$BASE_REF"); echo ok"
  if [[ -n "$HOST" ]]; then ssh -o BatchMode=yes "$HOST" "bash -c $(printf '%q' "$WTCMD")" || exit 3; else bash -c "$WTCMD" || exit 3; fi
  CWD="$CWD/.worktrees/$NAME"; echo "lane $CWD (branch $LANE_BRANCH from $BASE_REF)"
fi
RES="$(hrun tab create --workspace "$WS" --cwd "$CWD" --label "$NAME" --no-focus)" || { echo "spawn-worker: tab create failed: $RES" >&2; exit 1; }
PANE="$(printf '%s' "$RES" | python3 -c 'import sys,json
try:
  r=json.load(sys.stdin)["result"]; print((r.get("root_pane") or r.get("pane") or r)["pane_id"])
except Exception: pass')"
[[ -n "$PANE" ]] || { echo "spawn-worker: no pane id in: ${RES:0:200}" >&2; exit 1; }
sleep 2
hrun pane send-text "$PANE" "$(printf '\x15')" >/dev/null 2>&1; hrun pane send-text "$PANE" "$CMD" >/dev/null 2>&1; sleep 0.6; hrun pane send-keys "$PANE" Enter >/dev/null 2>&1
echo "started $NAME pane=$PANE harness=$HARNESS model=${MODEL:-raw} cwd=$CWD"

if [[ "$HARNESS" != raw ]]; then
  for i in $(seq 1 "${SPAWN_WAIT_TRIES:-15}"); do sleep 3; OUT="$(hread "$PANE")"; printf '%s' "$OUT" | grep -qE "$READY" && break; done
  if printf '%s' "$OUT" | grep -qiE 'trust this folder'; then hrun pane send-keys "$PANE" Down >/dev/null 2>&1; sleep 0.5; hrun pane send-keys "$PANE" Enter >/dev/null 2>&1; sleep 6; fi
  printf '%s' "$OUT" | grep -qE "$READY" || echo "spawn-worker: WARNING no prompt seen in pane $PANE after wait; sending the brief anyway" >&2
else
  sleep "${SPAWN_BOOT_SECS:-2}"
fi
if [[ -n "$BRIEF" ]]; then
  HOSTFLAG=(); [[ -n "$HOST" ]] && HOSTFLAG=(--host "$HOST")
  "$HERE/az-send" "${HOSTFLAG[@]}" "$PANE" "Read and execute the brief at $BRIEF. It ends with RETURN and STOP; obey both."
fi
