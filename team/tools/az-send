#!/usr/bin/env bash
# az-send — deliver one message to an agent and PROVE it was submitted.
#
#   az-send [--host SSH_HOST] [--session NAME] <pane-id> "message"          herdr pane
#   az-send [--wait SECONDS] term_<uuid>|orca:<title> "message"             Orca terminal
#   az-send --substrate orca <target> "message"                             force the Orca path
#   HERDR_SESSION=pool az-send w3:p1 "…"          another herdr session on the same host
#
# Two substrates, one contract: exit 0 only when the message is with the agent.
#   herdr  the Macs and today's VPS panes — submission is INFERRED from the rendered line.
#   orca   the VPS — submission is OBSERVED. `terminal send --enter --wait-submit` returns a
#          receipt whose stages separate input_accepted from turn_started, and the receipt can be
#          replayed with --retry-request instead of the prompt being delivered twice. A target
#          that starts `term_` or `orca:` picks this path on its own.
#
# Exit 0 = with the agent (a turn started, or it is mid-turn and the input is queued behind it —
# Claude Code reads queued input when the turn ends). Exit 2 = NOT with the agent: no turn start
# AND nothing running. Exit 1 = unreachable. "No turn start within N seconds" alone is NOT a
# failure: measured 2026-09-12, an owner blocked on a 5m30s bash call reported no turn start and
# had in fact queued, read and acted on the message. az-send looks at the screen before it calls it.
#
# Why: `herdr pane send-text` types without pressing Enter, and a later bare `send-keys Enter`
# on text already sitting at the prompt does NOT submit — the pane re-renders it and it looks
# sent. Ten dispatches were lost that way on 2026-09-11.
#
# Clearing the line: herdr's key parser rejects every spelling of ctrl-u (`invalid_key`, tested
# 2026-09-11 on 0.6.5), so the earlier `send-keys ctrl-u || true` silently never cleared. The
# raw 0x15 byte through send-text reaches the pty and every line editor treats it as kill-line;
# proven on the VPS against a deliberately stranded line.
#
# Exit 0 = submitted (or queued behind a running turn) · 2 = stranded · 1 = unreachable.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
HOST=""; SESSION="${HERDR_SESSION:-}"; SUBSTRATE=""; WAIT="${AZ_SEND_WAIT:-25}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) HOST="$2"; shift 2;;
    --session) SESSION="$2"; shift 2;;
    --substrate) SUBSTRATE="$2"; shift 2;;
    --wait) WAIT="$2"; shift 2;;
    -h|--help) sed -n 2,24p "$0"; exit 0;;
    --) shift; break;;
    -*) echo "az-send: unknown flag $1" >&2; exit 64;;
    *) break;;
  esac
done
[[ $# -ge 2 ]] || { echo 'usage: az-send [--host H] [--session S] <pane-id> "message"' >&2; exit 64; }
PANE="$1"; shift; MSG="$*"

# ---- Orca ------------------------------------------------------------------------------
# shellcheck source=lib/orca.sh
. "$HERE/lib/orca.sh"
if [[ "$SUBSTRATE" == orca ]] || { [[ -z "$SUBSTRATE" ]] && orca_is_target "$PANE"; }; then
  [[ -z "$HOST" ]] || { echo "az-send: --host is a herdr flag; Orca reaches its own hosts by handle" >&2; exit 64; }
  H="$(orca_resolve_handle "$PANE")" || { echo "az-send: no Orca terminal matches $PANE" >&2; exit 1; }
  orca_send "$H" "$MSG" "$WAIT"; exit $?
fi

# ---- herdr -----------------------------------------------------------------------------
run() {
  local cmd=(herdr); [[ -n "$SESSION" ]] && cmd+=(--session "$SESSION"); cmd+=("$@")
  if [[ -n "$HOST" ]]; then ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" "$(printf '%q ' "${cmd[@]}")"
  else "${cmd[@]}"; fi
}

# Refuse a pane that holds no agent. On 2026-09-12 Agent Zero moved to Orca and his old pane became a root
# shell; six messages were typed into bash (each rejected as a syntax error — luck, not design).
if ! run agent list 2>/dev/null | grep -q "\"pane_id\":\"$PANE\""; then
  echo "az-send: no agent in $PANE (herdr agent list) — it is a shell. Refusing; find the agent's new address (fleet-status, az-target)." >&2; exit 3
fi
run pane send-text "$PANE" "$(printf '\x15')" >/dev/null 2>&1 || { echo "az-send: pane $PANE unreachable" >&2; exit 1; }
run pane send-text "$PANE" "$MSG" >/dev/null 2>&1 || { echo "az-send: send-text failed" >&2; exit 1; }
sleep 0.6
run pane send-keys "$PANE" Enter >/dev/null 2>&1 || { echo "az-send: Enter failed" >&2; exit 1; }
sleep 2

OUT="$(run pane read "$PANE" --lines 20 --format text 2>/dev/null || true)"
TAIL="$(printf '%s\n' "$OUT" | grep -v '^[[:space:]]*$' | tail -6)"
if printf '%s\n' "$TAIL" | grep -qE '^❯ .{3,}'; then
  echo "az-send: STRANDED on $PANE — text still at the prompt. Read the pane before retrying." >&2
  printf '%s\n' "$TAIL" | grep -E '^❯ ' | cut -c1-100 >&2
  exit 2
fi
if printf '%s\n' "$OUT" | grep -qE '\([0-9]+s · |Running…|[0-9]+ shell'; then
  echo "submitted $PANE (agent working)"
else
  echo "submitted $PANE (queued behind its turn, or accepted at an idle prompt)"
fi
