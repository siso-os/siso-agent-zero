#!/usr/bin/env bash
# az-deliver — forced command for the agents user's ssh key to root@localhost on a team host.
# Two verbs, nothing else reaches root's herdr:
#   <message>              deliver it to the Project Agent Zero's pane (/etc/siso-az.pane) and press Enter
#   __fleet__ <space>      read-only: JSON of the panes in that space with each pane's last 8 lines
# Installed at /usr/local/bin/az-deliver; authorized_keys line: command="/usr/local/bin/az-deliver",no-pty,... <key>
set -u
CMD="${SSH_ORIGINAL_COMMAND:-}"; [ -n "$CMD" ] || { echo "az-deliver: empty command" >&2; exit 64; }
case "$CMD" in
  __fleet__\ *)
    SPACE="${CMD#__fleet__ }"
    python3 - "$SPACE" <<'PY'
import json,subprocess,sys
sp=sys.argv[1]
def h(*a):
    try: return json.loads(subprocess.run(["herdr",*a],capture_output=True,text=True,timeout=20).stdout)["result"]
    except Exception: return {}
panes=h("pane","list","--workspace",sp).get("panes",[]); tabs={t["tab_id"]:t.get("label","") for t in h("tab","list","--workspace",sp).get("tabs",[])}
out=[]
for p in panes:
    tail=subprocess.run(["herdr","pane","read",p["pane_id"],"--lines","8","--format","text"],capture_output=True,text=True,timeout=20).stdout
    out.append({"pane":p["pane_id"],"tab_id":p.get("tab_id"),"label":tabs.get(p.get("tab_id"),""),"cwd":p.get("cwd"),"agent":p.get("agent"),"agent_status":p.get("agent_status"),"tail":tail[-600:]})
print(json.dumps({"space":sp,"panes":out}))
PY
    ;;
  *)
    PANE="$(cat /etc/siso-az.pane 2>/dev/null)"; [ -n "$PANE" ] || { echo "az-deliver: no pane in /etc/siso-az.pane" >&2; exit 1; }
    herdr pane send-text "$PANE" "$(printf '\x15')" >/dev/null 2>&1 || { echo "az-deliver: pane $PANE unreachable" >&2; exit 1; }
    herdr pane send-text "$PANE" "$CMD" >/dev/null 2>&1; sleep 0.7; herdr pane send-keys "$PANE" Enter >/dev/null 2>&1
    printf '%s | %s\n' "$(date -u +%FT%TZ)" "$CMD" >> /opt/siso-internal-labs-agents/inbox/az-notify.log 2>/dev/null || true
    echo "delivered to $PANE";;
esac
