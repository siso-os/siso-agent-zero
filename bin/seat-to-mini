#!/usr/bin/env python3
"""seat-to-mini NAME [--effort medium] [--compact 33]: move one hosted laptop seat to the Mac mini, same conversation.

Shaan, 13 Oct ~00:30 (via HARNESS): "get them all to set up on the Mac mini here, all of them on the correct way".
ab-remote start (Agent Base services/host) runs a seat on the mini under tmux ab-owners and mirrors it into the laptop's nav,
but it does not carry the conversation. This copies <config>/projects/<cwd slug>/<session>.jsonl (and the <session>/ folder)
to the same path under the mini's ~/.claude-siso or ~/.config/claude-siso-3, stops the laptop host only after the copy is
proven, then starts it there with --resume. The repo must already exist on the mini at the same path. Rollback: the laptop
copy stays; `siso-host --resume <session>` in its old pane brings it back.
"""
import glob, json, os, subprocess, sys, time

HOME = os.path.expanduser("~")
HOSTS = f"{HOME}/.local/state/agent-base/hosts"
AB = f"{HOME}/SISO_Workspace/SISO_Agency/apps/siso-internal-labs/siso-internal-labs-agent-base"
SSH = ["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", "mini-fast"]
args = sys.argv[1:]
if not args: sys.exit(__doc__)
name = args[0]
opt = lambda k, d: args[args.index(k) + 1] if k in args else d
effort, compact = opt("--effort", "medium"), opt("--compact", "33")

def alive(pid):
    try: os.kill(int(pid), 0); return True
    except Exception: return False

recs = [json.load(open(f)) for f in glob.glob(f"{HOSTS}/w*_p*.json")]
recs = [d for d in recs if d.get("name") == name and alive(d.get("pid") or 0)]
if not recs: sys.exit(f"{name}: no live laptop host")
d = max(recs, key=lambda r: int(r.get("updatedAt") or 0))
if d.get("state") != "idle": sys.exit(f"{name}: {d.get('state')}, not idle; move it at its next idle")
cfg, session, cwd, pane = d["configDir"], d["session"], d["cwd"], d["pane"]
login = "~/.config/claude-siso-3" if cfg.endswith("claude-siso-3") else "~/.claude-siso"
slug = "-" + os.path.realpath(cwd).lstrip("/").replace("/", "-").replace("_", "-")
src = next(iter(sorted(glob.glob(f"{cfg}/projects/*/{session}.jsonl"), key=os.path.getmtime, reverse=True)), None)
if not src: sys.exit(f"{name}: no {session}.jsonl under {cfg}/projects")
dst = f"{login}/projects/{slug}"

def ssh(cmd, **kw): return subprocess.run(SSH + [cmd], capture_output=True, text=True, timeout=kw.get("timeout", 60))
r = ssh(f"test -d '{cwd}' && echo OK")
if "OK" not in r.stdout: sys.exit(f"{name}: {cwd} is missing on the mini; clone it there first")
# Copy while the laptop host still runs, then stop it and copy the final tail, so a failed copy changes nothing.
def copy():
    ssh(f"mkdir -p {dst}")
    items = [src] + ([src[:-6]] if os.path.isdir(src[:-6]) else [])
    for it in items:
        tar = subprocess.Popen(["tar", "-C", os.path.dirname(it), "-cf", "-", os.path.basename(it)], stdout=subprocess.PIPE)
        r = subprocess.run(SSH + [f"tar -C {dst} -xf -"], stdin=tar.stdout, capture_output=True, text=True, timeout=600)
        tar.wait()
        if r.returncode: sys.exit(f"{name}: copy failed: {r.stderr.strip()[:200]}")
copy()
os.kill(int(d["pid"]), 15)
for _ in range(30):
    if not alive(d["pid"]): break
    time.sleep(1)
copy()
size = ssh(f"wc -c < {dst}/{session}.jsonl").stdout.strip()
if size != str(os.path.getsize(src)): sys.exit(f"{name}: size differs after copy (mini {size}, laptop {os.path.getsize(src)}); laptop copy kept")
r = subprocess.run([f"{AB}/services/host/bin/ab-remote", "start", "--on", "mini", "--name", name, "--cwd", cwd, "--resume", session,
                    "--config-dir", login.replace("~", "$HOME"), "--model", d.get("model") or "claude-opus-5-5[1m]",
                    "--effort", effort, "--compact", compact], capture_output=True, text=True, timeout=180)
print((r.stdout + r.stderr).strip()[-400:])
if r.returncode: sys.exit(f"{name}: ab-remote failed; the laptop copy is intact (resume it in {pane})")
subprocess.run(["herdr", "pane", "close", pane], capture_output=True)
print(f"{name}: moved to the mini ({int(size) // 1_000_000} MB conversation, {login}, effort {effort}, compact {compact}%); laptop pane {pane} closed")
