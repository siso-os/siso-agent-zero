#!/usr/bin/env python3
"""house-check: can a session that remembers nothing find what Agent Zero knows? (docs/HOUSE.md)

Asks a cheap model with no context the questions in docs/house-check.json, from this repo only, then scores the answers.
  house-check            run, print the score and every miss, append the score to docs/passes.jsonl
A miss is a bug in the house: move the fact to the right room or add it, then add the question that caught it.
"""
import datetime, json, os, re, subprocess, sys, tempfile

HOME = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
Q = json.load(open(os.path.join(HOME, "docs/house-check.json")))["questions"]
brief = f"""TASK: house-check (Agent Zero memory test)
You remember nothing. Working directory: {HOME}. Answer each question using only what is in this directory (start with AGENTS.md,
use `bin/recall <words>` to search). Do not edit anything. Your final message must be exactly one fenced ```json block: a list of
{{"n": <question number>, "answer": "<one or two sentences>", "source": "<path:line you took it from>"}}.

""" + "\n".join(f"{i}. {x['q']}" for i, x in enumerate(Q, 1))
with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
    f.write(brief)
run = os.environ.get("CODEX_RUN") or "codex-run"
r = subprocess.run([run, "-e", "low", "-C", HOME, f.name], capture_output=True, text=True, timeout=1800)
os.unlink(f.name)
m = re.search(r"```json\s*(\[.*?\])\s*```", r.stdout, re.S)
if not m:
    print("house-check: no answers came back\n" + r.stdout[-800:]); sys.exit(1)
ans = {a["n"]: a for a in json.loads(m.group(1))}
json.dump(ans, open(os.path.join(HOME, "docs/house-check.last.json"), "w"), indent=1)  # every answer, to read a miss
score, misses = 0, []
for i, x in enumerate(Q, 1):
    a = ans.get(i, {})
    ok = any(e.lower() in (a.get("answer", "") + " " + a.get("source", "")).lower() for e in x["expect"])
    score += ok
    print(f"{'ok  ' if ok else 'MISS'} {i}. {x['q']}\n      -> {a.get('answer', '(none)')[:200]}  [{a.get('source', '')}]")
    if not ok: misses.append(i)
print(f"house-check: {score}/{len(Q)}")
with open(os.path.join(HOME, "docs/passes.jsonl"), "a") as f:
    f.write(json.dumps({"at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), "label": "house-check",
                        "house_check": f"{score}/{len(Q)}", "misses": misses}) + "\n")
sys.exit(0 if score == len(Q) else 1)
