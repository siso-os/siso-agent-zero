#!/usr/bin/env python3
"""a0-shown: the log of every URL Agent Zero has given Shaan.

Usage: a0-shown add URL [--note TEXT]   record that URL was shown to Shaan
       a0-shown check URL               print when it was shown (exit 0), or exit 1 if never
Writes ~/.local/state/a0/shown.jsonl, one JSON line per add.
"""
import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

LOG = Path.home() / ".local/state/a0/shown.jsonl"


def key(url):
    return url.strip().rstrip("/")


def entries():
    if not LOG.exists():
        return []
    return [json.loads(line) for line in LOG.read_text().splitlines() if line.strip()]


def main():
    parser = argparse.ArgumentParser(prog="a0-shown")
    sub = parser.add_subparsers(dest="cmd", required=True)
    add = sub.add_parser("add")
    add.add_argument("url")
    add.add_argument("--note", default="")
    check = sub.add_parser("check")
    check.add_argument("url")
    args = parser.parse_args()

    if args.cmd == "add":
        LOG.parent.mkdir(parents=True, exist_ok=True)
        row = {"url": key(args.url), "note": args.note,
               "at": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")}
        with LOG.open("a") as f:
            f.write(json.dumps(row) + "\n")
        print(f"shown: {row['url']} at {row['at']}")
        return 0

    hits = [e for e in entries() if e["url"] == key(args.url)]
    if not hits:
        print(f"never shown: {key(args.url)}")
        return 1
    last = hits[-1]
    print(f"shown {len(hits)}x, last at {last['at']}" + (f", note: {last['note']}" if last["note"] else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
