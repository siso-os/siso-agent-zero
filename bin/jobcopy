#!/bin/sh
# jobcopy JOB [BRANCH]: a job's own copy of Agent Base (git worktree from origin/dev, dependencies installed), so every Builder job
# writes alone and jobs run side by side. Replaces the Builder queue and its lock (Shaan, 4 Oct: "this Q ... keeps on causing us more
# issues than it's worth ... Is this something we can delete?"). Run the job with: codex-run --as Builder -C <printed path> jobs/JOB.md
set -eu
W="$HOME/SISO_Workspace/_data/worktrees/siso-internal-labs-agent-base"; j="${1:?job}"; b="${2:-job/$j}"
R="$HOME/SISO_Workspace/SISO_Agency/apps/siso-internal-labs/siso-internal-labs-agent-base"  # the repo itself (5 Oct: pair-ab is gone); its working tree is never touched
git -C "$R" fetch -q origin && git -C "$R" worktree add -q "$W/$j" -b "$b" origin/dev
(cd "$W/$j" && heavy -- pnpm install --frozen-lockfile --prefer-offline > /dev/null) && echo "$W/$j"
